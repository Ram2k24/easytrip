{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", ".npmrc", "pnpm-workspace.yaml"],
  "globalEnv": [
    "APP_ENV",
    "APP_URL",
    "API_URL",
    "WEB_ORIGIN",
    "ALLOWED_ORIGINS",
    "LOG_LEVEL",
    "TZ_DEFAULT",
    "DATABASE_URL",
    "DB_POOL_MAX",
    "DB_STATEMENT_TIMEOUT_MS",
    "REDIS_URL",
    "REDIS_PREFIX",
    "REDIS_REQUIRED",
    "PORT",
    "API_PORT",
    "WEB_PORT",
    "OTEL_ENABLED",
    "OTEL_ENDPOINT",
    "OTEL_EXPORTER",
    "OTEL_SAMPLE_RATE",
    "OTEL_SERVICE_NAME",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_SITE_NAME",
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
