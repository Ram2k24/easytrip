# Development defaults (Arch §26 — local dev). No secrets: these credentials only
# exist inside the local compose stack / embedded dev database.
APP_ENV=development
APP_NAME=easytrip
APP_VERSION=0.5.0
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
LOG_PRETTY=true
TZ_DEFAULT=Asia/Katmandu
SERVICE_NAME=easytrip-api

HOST=0.0.0.0
PORT=4000
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgresql://easytrip:easytrip@127.0.0.1:5432/easytrip
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_SCHEMA_TABLES=outbox,user,role,permission,user_role,role_permission,auth_session,mfa_enrollment,otp_issue,audit_log,ven_org,ven_user

REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=easytrip
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=1500

OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=easytrip-api
OTEL_SAMPLE_RATE=1

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Easy Trip Nepal

# ---- Authentication & authorization (Phase 06, Arch §5/§6)
# These are development-only values. Nothing here may be reused in production;
# `check:env` rejects the placeholder ENCRYPTION_KEY when APP_ENV=production.
JWT_SECRET=dev-only-access-token-signing-key-change-me-0123456789abcdef
JWT_ISSUER=easytrip
JWT_AUDIENCE=easytrip-web
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_D=30
COOKIE_SECURE=false
SESSION_MAX_ACTIVE=5
ADMIN_SESSIONS_PER_FINGERPRINT=1

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=10

MFA_ISSUER=Easy Trip Nepal (dev)
MFA_PERIOD_S=30
MFA_DIGITS=6
MFA_WINDOW=1
MFA_STEP_UP_WINDOW_S=300
MFA_MAX_ATTEMPTS=5

OTP_DIGITS=6
OTP_VERIFY_TTL_S=600
OTP_RESET_TTL_S=1800
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_S=900

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_S=900
AUTH_MAX_FAILED_ATTEMPTS=10

# 32 bytes hex. Development placeholder — rejected in production.
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
IP_HASH_SALT=dev-only-ip-hash-salt-change-me

# `log` writes the message to the structured log instead of sending it.
MAIL_TRANSPORT=log
MAIL_FROM=Easy Trip Nepal <no-reply@easytrip.local>
