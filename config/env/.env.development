# Development defaults (Arch §26 — local dev). No secrets: these credentials only
# exist inside the local compose stack / embedded dev database.
APP_ENV=development
APP_NAME=easytrip
APP_VERSION=0.5.0
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
LOG_PRETTY=true
TZ_DEFAULT=Asia/Katmandu
SERVICE_NAME=easytrip-api

HOST=0.0.0.0
PORT=4000
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgresql://easytrip:easytrip@127.0.0.1:5432/easytrip
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_SCHEMA_TABLES=outbox

REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=easytrip
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=1500

OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_SERVICE_NAME=easytrip-api
OTEL_SAMPLE_RATE=1

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Easy Trip Nepal
