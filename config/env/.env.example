# Easy Trip Nepal — environment catalog (Arch §25.2)
#
# Copy to config/env/.env (gitignored) or config/env/.env.local and fill in.
# Placeholders only — never commit real credentials (Arch §25.3).
# Values are validated at boot by packages/contracts/src/env/env.schema.ts;
# an invalid environment aborts startup with a field-level message.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development            # development | test | staging | production
APP_NAME=easytrip
APP_VERSION=0.5.0
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000   # strict CORS allowlist, comma-separated
LOG_LEVEL=info                 # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=false               # pino-pretty (development only)
TZ_DEFAULT=Asia/Katmandu       # report rendering timezone (PRD RP-02)
SERVICE_NAME=easytrip-api

# ── HTTP ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# ── Database (PostgreSQL 16, Arch §4) ────────────────────────────────────────
DATABASE_URL=postgresql://easytrip:easytrip@127.0.0.1:5432/easytrip
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_SCHEMA_TABLES=outbox        # tables /health asserts exist

# ── Redis (cache / rate limit / queues, Arch §11) ────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=easytrip
REDIS_REQUIRED=false           # must be true in production
REDIS_CONNECT_TIMEOUT_MS=1500

# ── Telemetry (OTel, Arch §15) ───────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_ENDPOINT=                 # e.g. http://otel-collector:4317
OTEL_EXPORTER=none             # otlp-http | console | none
OTEL_SERVICE_NAME=easytrip-api
OTEL_SAMPLE_RATE=1

# ── Authentication & authorization (Phase 06 — Arch §5, §6) ──────────────────
# Required. No defaults: the API refuses to boot without them.
JWT_SECRET=                 # >= 64 random characters (HS256 signing key)
ENCRYPTION_KEY=             # 64 hex chars = 32 bytes (AES-256-GCM, TOTP secrets)
IP_HASH_SALT=               # >= 32 random characters (IPs are stored hashed)

JWT_ISSUER=easytrip
JWT_AUDIENCE=easytrip-web
ACCESS_TOKEN_TTL_S=900      # Arch §5.2: 15 min
REFRESH_TOKEN_TTL_D=30      # Arch §5.2: 30 d
COOKIE_DOMAIN=              # app root domain, e.g. easytrip.com.np
COOKIE_SECURE=true
SESSION_MAX_ACTIVE=5        # Arch §5.2: customer max 5 families
ADMIN_SESSIONS_PER_FINGERPRINT=1

# Argon2id — OWASP baseline / decision E-5. Do not lower these.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=10

# TOTP (RFC 6238). Required for every admin-class role.
MFA_ISSUER=Easy Trip Nepal
MFA_PERIOD_S=30
MFA_DIGITS=6
MFA_WINDOW=1
MFA_STEP_UP_WINDOW_S=300    # Arch §6.6: 5 min
MFA_MAX_ATTEMPTS=5

# One-time codes (email verification + password reset)
OTP_DIGITS=6
OTP_VERIFY_TTL_S=600
OTP_RESET_TTL_S=1800
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3        # Arch §5.1: 3 per window per identifier
OTP_RATE_LIMIT_WINDOW_S=900

# Arch §5.3: 5 per 15 min, per IP *and* per identifier
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_S=900
AUTH_MAX_FAILED_ATTEMPTS=10

# Email delivery. `smtp` is mandatory in production; `log` drops mail.
MAIL_TRANSPORT=smtp
MAIL_FROM=Easy Trip Nepal <no-reply@easytrip.com.np>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── Web (build-time allowlist — NEXT_PUBLIC_ only) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Easy Trip Nepal

# ── Provisioned in later phases (placeholders, validated when wired) ─────────
# Storage (Arch §8):      S3_ENDPOINT, S3_REGION, S3_BUCKET_{PRIVATE,MEDIA,ORIG,TMP},
#                         S3_ACCESS_KEY, S3_SECRET_KEY, CDN_URL
# Payments (Arch §7):     {PSP}_MODE, {PSP}_CRED_REF, {PSP}_WEBHOOK_SECRET_REF, {PSP}_ENABLED
# Notifications (§13):    EMAIL_FROM, EMAIL_PROVIDER_CRED_REF
# Media (§9):             MEDIA_CONCURRENCY, MEDIA_MAX_PER_ORG_GB
# Jobs (§12):             TIMER_SWEEP_INTERVAL_S=30, WORKER_CONCURRENCY_{QUEUE}
# Rate limits (§3.6):     RL_TIER_{ANON,AUTH,STRICT,PAYMENT}_RPM
