# Test environment. LOG_LEVEL=silent keeps assertion output readable.
APP_ENV=test
APP_NAME=easytrip
APP_VERSION=0.5.0-test
SERVICE_NAME=easytrip-api-test
LOG_LEVEL=silent
LOG_PRETTY=false

HOST=127.0.0.1
PORT=4100

DATABASE_URL=postgresql://easytrip:easytrip@127.0.0.1:55441/easytrip_test
DB_POOL_MAX=4
DB_SCHEMA_TABLES=outbox,user,role,permission,user_role,role_permission,auth_session,mfa_enrollment,otp_issue,audit_log,ven_org,ven_user

REDIS_URL=redis://127.0.0.1:6390
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=300

OTEL_ENABLED=false
OTEL_EXPORTER=none

# ---- Authentication & authorization (Phase 06, Arch §5/§6)
# These are development-only values. Nothing here may be reused in production;
# `check:env` rejects the placeholder ENCRYPTION_KEY when APP_ENV=production.
JWT_SECRET=test-only-access-token-signing-key-change-me-0123456789abcde
JWT_ISSUER=easytrip
JWT_AUDIENCE=easytrip-web
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_D=30
COOKIE_SECURE=false
SESSION_MAX_ACTIVE=5
ADMIN_SESSIONS_PER_FINGERPRINT=1

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=10

MFA_ISSUER=Easy Trip Nepal (test)
MFA_PERIOD_S=30
MFA_DIGITS=6
MFA_WINDOW=1
MFA_STEP_UP_WINDOW_S=300
MFA_MAX_ATTEMPTS=5

OTP_DIGITS=6
OTP_VERIFY_TTL_S=600
OTP_RESET_TTL_S=1800
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_S=900

AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_S=900
AUTH_MAX_FAILED_ATTEMPTS=10

# 32 bytes hex. Development placeholder — rejected in production.
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
IP_HASH_SALT=test-only-ip-hash-salt-change-me-xy

# `log` writes the message to the structured log instead of sending it.
MAIL_TRANSPORT=log
MAIL_FROM=Easy Trip Nepal <no-reply@easytrip.local>
