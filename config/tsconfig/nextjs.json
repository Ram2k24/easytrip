{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Easy Trip Nepal — Next.js application",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  }
}
