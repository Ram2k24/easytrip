{
  "name": "@easytrip/web",
  "version": "0.5.0",
  "private": true,
  "description": "Easy Trip Nepal \u2014 Next.js 15 App Router web application (Arch \u00a71).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next *.tsbuildinfo",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "next lint --dir src",
    "lint:fix": "next lint --dir src --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@easytrip/contracts": "workspace:*",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
