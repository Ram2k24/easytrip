{
  "name": "@easytrip/api",
  "version": "0.5.0",
  "private": true,
  "description": "Easy Trip Nepal \u2014 modular monolith API (NestJS 11, Arch \u00a72).",
  "license": "UNLICENSED",
  "main": "./dist/app.factory.js",
  "types": "./dist/app.factory.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.factory.d.ts",
      "default": "./dist/app.factory.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --config jest.config.ts"
  },
  "dependencies": {
    "@easytrip/contracts": "workspace:*",
    "@easytrip/database": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-http": "10.5.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
